# Documentation-only address: replace with your deployment LAN interface.
ARCHESTRA_BIND_ADDRESS=192.0.2.10

# HTTPS is the canonical browser/authentication origin. Direct HTTP remains a
# LAN recovery path and is retained in the API/trusted-origin lists.
ARCHESTRA_FRONTEND_URL=https://192.0.2.10
ARCHESTRA_API_BASE_URL=https://192.0.2.10,http://192.0.2.10:9000
ARCHESTRA_AUTH_ADDITIONAL_TRUSTED_ORIGINS=https://192.0.2.10,http://192.0.2.10:3000,http://192.0.2.10:9000
ARCHESTRA_SESSION_ORIGIN=https://192.0.2.10

# Deterministic prompt/response DLP proxy. Generate all three secret values on
# the VM; never commit the populated .env file.
DLP_BIND_ADDRESS=192.0.2.10
DLP_POLICY_BUILD_CONTEXT=/opt/ai-gateway/services/policy
DLP_POLICY_API_KEY=replace-with-random-32-byte-value
DLP_ADMIN_API_KEY=replace-with-a-different-random-32-byte-value
DLP_DB_PASSWORD=replace-with-a-random-database-password
DLP_IDENTITY_HMAC_KEY=replace-with-a-random-identity-signing-key

# The accepted POC path uses local Ollama for deployment canaries. When a paid
# API provider is approved, set its base URL and credential in the VM secret
# store and update the allowed model list through the guardrail admin UI.
DLP_UPSTREAM_BASE_URL=http://host.docker.internal:11434
DLP_UPSTREAM_API_KEY=ollama
DLP_ALLOWED_MODELS=granite4.1:3b
DLP_DEFAULT_MODEL=granite4.1:3b
DLP_AUTO_MODEL_ALIAS=gateway-auto
GATEWAY_TIMEZONE=America/Chicago
DLP_EXTERNAL_MODEL_ALIAS=gateway-cloud
DLP_EXTERNAL_ENABLED=false
# Non-secret commissioning state. The activation transaction writes these only
# after the paid provider passes the side-by-side canary.
DLP_MANAGED_ROUTING_MODE=local_only
DLP_EXTERNAL_MONTHLY_BUDGET_USD=0
DLP_EXTERNAL_INPUT_PRICE_PER_MILLION_USD=0
DLP_EXTERNAL_OUTPUT_PRICE_PER_MILLION_USD=0
DLP_DEFAULT_USER_ID=gateway-deux
DLP_DEFAULT_AGENT_ID=archestra-managed-chat
# Existing Mem0 Cloud project credential. Store only in the root-owned VM .env
# or approved password manager. The managed route deliberately uses one shared
# team namespace: ai-gateway::gateway-deux.
MEM0_API_KEY=replace-with-existing-mem0-cloud-project-key
MEM0_MIN_RELEVANCE_SCORE=0.25
MEM0_TRUSTED_READ_USER_IDS=
MEM0_EXPLICIT_TOP_K=20
# Written automatically after signed team identity acceptance succeeds.
DLP_MANAGED_GROUP_ID=

# Optional side-by-side OpenAI DLP route. Keep the populated values only in the
# VM's root-owned .env (or an approved secret store), never in Git. The service
# is not started by the normal compose command; enable it explicitly with the
# `openai` profile only after all values and the model choice are approved.
OPENAI_DLP_UPSTREAM_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_DLP_POLICY_API_KEY=
OPENAI_DLP_ALLOWED_MODELS=
OPENAI_DLP_DEFAULT_MODEL=
OPENAI_DLP_DEFAULT_USER_ID=gateway-deux
# Optional override; empty derives the collision-safe identity openai:<team-id>.
OPENAI_DLP_POLICY_GROUP=
# Retained only to remove a legacy broad agent assignment during migration.
OPENAI_DLP_DEFAULT_AGENT_ID=archestra-openai-chat
# Written automatically after guarded cloud-agent acceptance succeeds.
OPENAI_MANAGED_AGENT_ID=
# Written automatically after personal ChatGPT-subscription canary acceptance.
CHATGPT_SUBSCRIPTION_CANARY_AGENT_ID=
